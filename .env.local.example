# Example credentials file for local testing
# Copy this file to .env.local and fill in your real MELCloud credentials
# .env.local is git-ignored and will never be committed

# MELCloud Credentials
MELCLOUD_EMAIL=your-email@example.com
MELCLOUD_PASSWORD=your-password-here

# MQTT Broker Settings (optional - defaults shown)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=homeassistant

# Operational Settings (optional - defaults shown)
POLL_INTERVAL=60
LOG_LEVEL=INFO
